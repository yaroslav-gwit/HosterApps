# WebOS service defaults. Per-user identity, listener, credentials, title, and
# certificate paths live in /etc/hoster/webos/users/<username>.env.
WEBOS_LISTEN=127.0.0.1
WEBOS_ENCODER=h264enc-striped
WEBOS_USE_CPU=true
WEBOS_INITIAL_WIDTH=1280
WEBOS_INITIAL_HEIGHT=720
WEBOS_DEBUG=false
WEBOS_ENABLE_HTTPS=true
