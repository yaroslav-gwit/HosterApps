[Unit]
Description=Scaphandre Prometheus power metrics exporter
Documentation=https://hubblo-org.github.io/scaphandre-documentation/
After=network-online.target
Wants=network-online.target
# StartLimitIntervalSec must be greater than StartLimitBurst * RestartSec.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Scaphandre requires root to read RAPL data from /sys/class/powercap and
# process data from /proc.
Type=simple
User=root
Group=root
SyslogIdentifier=scaphandre

ExecStart=/opt/hoster/scaphandre/bin/scaphandre prometheus \
    --qemu \
    --containers \
    --port 1920 \
    --address 0.0.0.0

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

# Security hardening (limited by the exporter requiring root).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
